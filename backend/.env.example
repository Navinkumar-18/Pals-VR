# --- Ambedkar Digital Heritage API ---
# Copy to `.env` and fill in your values. NEVER commit `.env`.

# Runtime environment: development | test | production
ENVIRONMENT=development

# SQLAlchemy database URL.
# PostgreSQL (production/default):
#   postgresql+psycopg://archive:archive@localhost:5432/ambedkar_heritage
# Local development without PostgreSQL (prototype/testing only):
#   sqlite:///./dev.db
DATABASE_URL=postgresql+psycopg://archive:archive@localhost:5432/ambedkar_heritage

# Optional shared secret for administrative endpoints (POST/PUT/DELETE and
# non-published reads). If EMPTY, admin endpoints are open (dev mode only —
# set a key before exposing the API publicly).
ADMIN_API_KEY=

# Create tables and seed [SAMPLE] demo data on startup when the database is
# empty. Disable in production once real archival data exists.
AUTO_SEED=true

# CORS origins, comma-separated. "*" allows any origin (dev convenience;
# native Unity/Quest clients do not enforce CORS).
CORS_ORIGINS=*

# --- Phase E: OCR / document ingestion ---
# Root folder for uploaded original scans (relative to backend cwd). Originals
# are preserved byte-for-byte and never modified.
STORAGE_ROOT=storage

# Max accepted upload size in megabytes.
MAX_UPLOAD_MB=25

# OCR engine: rapid (default; pip-only, English) | tesseract (needs the
# tesseract binary + tessdata for en/hi/ta) | auto (rapid, fallback tesseract).
OCR_ENGINE=rapid

# Default OCR language (ISO 639-1: en/hi/ta). Requesting a language the active
# engine cannot OCR returns a clear configuration error (never a silent
# wrong-language run).
OCR_DEFAULT_LANGUAGE=en

# Run OCR on a background thread (true, production default) or inline (false,
# deterministic test runs).
OCR_ASYNC=true